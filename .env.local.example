# === YouTube Data API v3 ===
# https://console.cloud.google.com/apis/credentials 에서 발급
YOUTUBE_API_KEY=

# === Supabase ===
# https://supabase.com 프로젝트 생성 후 Settings > API 에서 확인
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버(동기화 스크립트)에서만 사용하는 키. 절대 클라이언트/공개 저장소에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=

# === AI 분석 (Claude 또는 OpenAI 중 하나만 있어도 동작하도록 설계됨) ===
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# "claude" 또는 "openai" - lib/ai-analysis.ts 에서 어떤 공급자를 쓸지 결정
AI_PROVIDER=claude

# === 동기화 API 보호용 (누구나 /api/sync 를 호출하지 못하도록) ===
SYNC_SECRET=change-this-to-a-random-string
